<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DXVKCompanion</RootNamespace>
    <AssemblyName>DXVK-Companion</AssemblyName>
    <Version>1.0.0</Version>
    <!-- Set explicitly rather than left to inherit from <Version>, so a git commit-hash
         suffix never gets silently appended by source-link/deterministic build behavior —
         which would otherwise make CompanionVersion's exact-string comparison against
         GitHub's release tag always report "outdated". -->
    <InformationalVersion>1.0.0</InformationalVersion>
    <Product>DXVK Companion</Product>
  </PropertyGroup>

  <!-- Publishing settings are intentionally not enabled for normal build operations.
       A RuntimeIdentifier and self-contained/single-file publish options should be
       supplied at publish time rather than stored here. -->
</Project>
